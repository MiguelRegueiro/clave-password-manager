<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.USE_BIOMETRIC" />
  <queries><intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent></queries>
  <application>
    <service android:name="com.clave.autofill.ClaveAutofillService"
      android:label="Clave" android:exported="true"
      android:permission="android.permission.BIND_AUTOFILL_SERVICE">
      <intent-filter><action android:name="android.service.autofill.AutofillService" /></intent-filter>
      <meta-data android:name="android.autofill" android:resource="@xml/clave_autofill" />
    </service>
    <activity android:name="com.clave.autofill.AutofillActivity"
      android:exported="false" android:excludeFromRecents="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:windowSoftInputMode="adjustResize" />
  </application>
</manifest>
