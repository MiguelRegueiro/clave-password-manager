{
  "name": "clave-vault",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "apk": "npx eas-cli build --platform android --profile preview",
    "apk:local": "node scripts/build-apk.mjs",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/password.test.mjs"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-dev-client": "~57.0.20",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.4",
    "expo-local-authentication": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-screen-capture": "~57.0.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@noble/ciphers": "1.3.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
